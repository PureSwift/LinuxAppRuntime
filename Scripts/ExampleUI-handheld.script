# ExampleUI on a 640 × 480 handheld, for Scripts/portmaster.sh test: the
# counter, the About sheet and Escape (B on the gamepad), and scrolling with
# the D-pad. Screenshots go to .build/shots/ in the checkout.
expect Hello, World!
tap +
expect 1
screenshot /src/.build/shots/handheld-main.png
tap About
screenshot /src/.build/shots/handheld-sheet.png
key escape
key down
expect Hello, World!
quit
